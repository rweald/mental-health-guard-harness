# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build artifacts (`uv build`)
/dist/
/build/

# uv / venv
.venv/

# Local environment: API keys live here. Ignored in-repo rather than relying on a
# machine-level global ignore, so a fresh clone is safe by default.
.envrc
.env

# OS
.DS_Store

# Docs: large source PDFs kept locally, never versioned
docs/*.pdf

# Eval outputs: scores/metrics artifacts (eval lineage), regenerated by the harness
results/

# Generated data (training lineage): authored libraries, dialogues, debug/reject dumps,
# regenerated by the authoring/generation harness. Keep the committed examples fixture.
# Note the `dir/*` form rather than `dir/`: git will not descend into an excluded
# directory, so a plain `data/` would make the negations below unreachable and silently
# drop the fixture from a fresh clone (the test suite loads it).
data/*
!data/scenarios/
data/scenarios/*
!data/scenarios/examples.json

# Prompt content is supplied by the user and never committed — the reference prompts
# are under a different licence than this repository (see prompts/README.md). Only the
# README explaining what goes here is tracked.
/prompts/*
!/prompts/README.md

# Release-check tooling: greps for prompt fragments, so it stays out of the tree.
/release-check/
